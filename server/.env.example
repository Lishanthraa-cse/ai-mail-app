PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (Atlas SRV or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ai-mail-app?retryWrites=true&w=majority

# Google OAuth 2.0 Credentials (Gmail API)
# Required scopes: https://www.googleapis.com/auth/gmail.readonly, https://www.googleapis.com/auth/gmail.send
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Authentication Secrets
SESSION_SECRET=super_secret_session_key_change_in_production
JWT_SECRET=super_secret_jwt_key_change_in_production

# OpenAI API Key (Optional: resilient fallback intent parser handles all commands out-of-the-box)
OPENAI_API_KEY=sk-your_openai_api_key_here
